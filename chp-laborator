//ToxerSyuner:

function encryptRowsColumns(text, numColumns) {
    const rows = [];
    let currentRow = '';

    for (let i = 0; i < text.length; i++) {
        currentRow += text[i];
        if (currentRow.length === numColumns) {
            rows.push(currentRow);
            currentRow = '';
        }
    }
    if (currentRow) {
        rows.push(currentRow.padEnd(numColumns, ' ')); 
    }

    let encryptedText = '';
    for (let col = 0; col < numColumns; col++) {
        for (let row = 0; row < rows.length; row++) {
            encryptedText += rows[row][col];
        }
    }

    return encryptedText;
}

const text = "Hello, World!";
const numColumns = 4;
console.log(encryptRowsColumns(text, numColumns)); // "Hoo!el,Wrdl l"

