//ParzPoxarinum:

function simpleSubstitutionCipher(text, shift) {
    const alphabet = 'abcdefghijklmnopqrstuvwxyz';
    const alphabetUpper = alphabet.toUpperCase();
    
    let result = '';

    for (let i = 0; i < text.length; i++) {
        const char = text[i];

        if (alphabet.includes(char)) {
            const index = alphabet.indexOf(char);
            const newIndex = (index + shift) % alphabet.length;
            result += alphabet[newIndex];
        } else if (alphabetUpper.includes(char)) {
            const index = alphabetUpper.indexOf(char);
            const newIndex = (index + shift) % alphabetUpper.length;
            result += alphabetUpper[newIndex];
        } else {
            result += char;
        }
    }

    return result;
}

const text = "Hello, World!";
const shift = 3;
console.log(simpleSubstitutionCipher(text, shift)); // "Khoor, Zruog!"

