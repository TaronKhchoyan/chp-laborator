//LCM:

function gcd(a, b) {
    while (b !== 0) {
        let temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

function lcm(a, b) {
    return Math.abs(a * b) / gcd(a, b);
}

let num1 = +prompt('input a first number');
let num2 = +prompt('input a second number');
console.log("LCM:", lcm(num1, num2));

