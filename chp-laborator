//GCD:
function gcd(a, b) {
    while (b !== 0) {
        let temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

let num1 = +prompt('input a first number');
let num2 = +prompt('input a second number');
console.log("GCD:", gcd(num1, num2)); 

