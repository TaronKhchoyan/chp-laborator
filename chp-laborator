//Caesar:

function caesarCipher(text, shift) {
    const alphabet = 'abcdefghijklmnopqrstuvwxyz';
    const alphabetUpper = alphabet.toUpperCase();
    let result = '';

    for (let i = 0; i < text.length; i++) {
        const char = text[i];

        if (alphabet.includes(char)) {
            const index = (alphabet.indexOf(char) + shift) % alphabet.length;
            result += alphabet[index];
        }
        else if (alphabetUpper.includes(char)) {
            const index = (alphabetUpper.indexOf(char) + shift) % alphabetUpper.length;
            result += alphabetUpper[index];
        }
        else {
            result += char;
        }
    }

    return result;
}

const text = "Hello, World!";
const shift = 3;
console.log(caesarCipher(text, shift)); // "Khoor, Zruog!"


