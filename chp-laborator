//RLE:

function rleEncode(text) {
    let encodedText = '';
    let count = 1;

    for (let i = 0; i < text.length; i++) {
        if (text[i] === text[i + 1]) {
            count++;
        } else {
            encodedText += text[i] + count;
            count = 1;
        }
    }

    return encodedText;
}

const text = "AAAABBBCCDAA";
console.log(rleEncode(text)); // "A4B3C2D1A2"
