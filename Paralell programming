#include <iostream>
#include <thread>
#include <vector>
#include <chrono>

// Функция, выполняющая тяжелую задачу
void computeHeavyTask(int id, int iterations) {
    long long sum = 0;
    for (int i = 0; i < iterations; ++i) {
        sum += i;
    }
    std::cout << "Поток " << id << " завершил работу. Сумма: " << sum << std::endl;
}

int main() {
    const int numThreads = 4; // Количество потоков
    const int iterations = 100000000; // Количество итераций для каждой задачи

    std::vector<std::thread> threads;

    // Запускаем потоки
    for (int i = 0; i < numThreads; ++i) {
        threads.emplace_back(computeHeavyTask, i, iterations);
    }

    // Ждем завершения всех потоков
    for (auto& t : threads) {
        t.join();
    }

    std::cout << "Все потоки завершили работу." << std::endl;

    return 0;
}
